# Uygulama adresi (OAuth ve parola sıfırlama bağlantılarında kullanılır)
SITE_URL=http://kavrix.uyelik
PORT=80
MEMBERS_DB_PATH=members.db

# Google Cloud OAuth 2.0 Web application bilgileri
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://kavrix.uyelik/auth/google/callback

# Parola sıfırlama e-postası için TLS destekli SMTP hesabı
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
